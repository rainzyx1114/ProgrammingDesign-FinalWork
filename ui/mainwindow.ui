    border-radius: 6px;
    padding: 8px;
    color: #D4D4D4; /* 浅灰白色字体 */
    selection-background-color: #264F78;
}
QPlainTextEdit:focus {
    border: 1px solid #007ACC; /* VS Code 经典蓝 */
}
QToolBar { background: transparent; border: none; }
</string>
